<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>스터디 타임락 (Study TimeLock)</title>
    <style>
        /* CSS 스타일링 */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, system-ui, Roboto, sans-serif;
        }

        body {
            background-color: #f4f6f8;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .container {
            width: 100%;
            max-width: 400px;
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            padding: 30px 20px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        h1 {
            color: #2c3e50;
            font-size: 1.5rem;
            margin-bottom: 8px;
        }

        p.subtitle {
            color: #7f8c8d;
            font-size: 0.9rem;
            margin-bottom: 25px;
        }

        .form-group {
            margin-bottom: 20px;
            text-align: left;
        }

        label {
            display: block;
            font-size: 0.85rem;
            font-weight: bold;
            color: #34495e;
            margin-bottom: 8px;
        }

        input[type="number"], select {
            width: 100%;
            padding: 12px;
            border: 1px solid #dcdde1;
            border-radius: 10px;
            font-size: 1rem;
            outline: none;
            transition: border 0.3s;
        }

        input[type="number"]:focus, select:focus {
            border-color: #3498db;
        }

        .btn {
            width: 100%;
            padding: 14px;
            background-color: #3498db;
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.3s;
        }

        .btn:hover {
            background-color: #2980b9;
        }

        .btn-stop {
            background-color: #e74c3c;
            margin-top: 10px;
        }

        .btn-stop:hover {
            background-color: #c0392b;
        }

        /* 타이머 영역 */
        .timer-display {
            display: none;
            margin-top: 10px;
        }

        .timer-circle {
            width: 180px;
            height: 180px;
            border-radius: 50%;
            border: 8px solid #ebedf0;
            border-top: 8px solid #3498db;
            margin: 0 auto 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 2rem;
            font-weight: bold;
            color: #2c3e50;
        }

        .alert-message {
            margin-bottom: 15px;
            padding: 10px;
            border-radius: 8px;
            font-size: 0.85rem;
            display: none;
        }

        .alert-warning {
            background-color: #fff3cd;
            color: #856404;
            border: 1px solid #ffeeba;
        }

        /* 차단 화면 (오버레이) */
        .lock-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.92);
            z-index: 9999;
            color: white;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 20px;
            text-align: center;
        }

        .lock-overlay h2 {
            font-size: 2rem;
            color: #e74c3c;
            margin-bottom: 15px;
        }

        .lock-overlay p {
            font-size: 1.1rem;
            line-height: 1.6;
            margin-bottom: 25px;
            color: #ecf0f1;
        }

        .lock-overlay .btn-reset {
            background-color: #2ecc71;
            width: auto;
            padding: 12px 30px;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>📱 스터디 타임락</h1>
        <p class="subtitle">공부할 시간을 정하고 집중해 보세요!</p>

        <!-- STEP 1: 설정 폼 -->
        <div id="setup-form">
            <div class="form-group">
                <label for="minutes">목표 공부 시간 (분 단위)</label>
                <input type="number" id="minutes" min="1" max="180" value="10" placeholder="예: 30">
            </div>

            <div class="form-group">
                <label for="target-app">차단 대상 앱 지정</label>
                <select id="target-app">
                    <option value="전체 스마트폰">스마트폰 전체 차단</option>
                    <option value="유튜브/SNS">유튜브 & SNS</option>
                    <option value="게임 앱">게임 앱</option>
                    <option value="웹 브라우저">웹 브라우저</option>
                </select>
            </div>

            <button class="btn" id="start-btn">공부 시작하기</button>
        </div>

        <!-- STEP 2~3: 타이머 진행 화면 -->
        <div id="timer-screen" class="timer-display">
            <div id="alert-box" class="alert-message alert-warning"></div>
            
            <div class="timer-circle" id="time-text">00:00</div>
            
            <p id="app-info" style="font-size: 0.85rem; color: #7f8c8d; margin-bottom: 15px;"></p>
            
            <button class="btn btn-stop" id="stop-btn">집중 중단하기</button>
        </div>
    </div>

    <!-- STEP 4: 화면 차단 오버레이 -->
    <div class="lock-overlay" id="lock-screen">
        <h2>🔒 핸드폰 사용이 제한되었습니다!</h2>
        <p>설정한 공부 제한 시간이 완료되었습니다.<br><strong id="locked-app-name"></strong> 사용이 차단됩니다.</p>
        <p style="font-size: 0.9rem; color: #bdc3c7;">이제 잠시 휴식을 취하거나 계속 공부에 집중하세요!</p>
        <button class="btn btn-reset" id="reset-btn">확인 및 처음으로</button>
    </div>

    <!-- 자바스크립트 알고리즘 및 동작 구현 -->
    <script>
        let timerInterval;
        let totalSeconds = 0;
        let remainingSeconds = 0;

        const setupForm = document.getElementById('setup-form');
        const timerScreen = document.getElementById('timer-screen');
        const lockScreen = document.getElementById('lock-screen');
        
        const minutesInput = document.getElementById('minutes');
        const targetAppSelect = document.getElementById('target-app');
        const timeText = document.getElementById('time-text');
        const alertBox = document.getElementById('alert-box');
        const appInfo = document.getElementById('app-info');
        const lockedAppName = document.getElementById('locked-app-name');

        const startBtn = document.getElementById('start-btn');
        const stopBtn = document.getElementById('stop-btn');
        const resetBtn = document.getElementById('reset-btn');

        // [STEP 1] 공부 시작
        startBtn.addEventListener('click', () => {
            const mins = parseInt(minutesInput.value);
            if (isNaN(mins) || mins <= 0) {
                alert('올바른 시간을 입력해 주세요.');
                return;
            }

            totalSeconds = mins * 60;
            remainingSeconds = totalSeconds;

            appInfo.innerText = `차단 대상: [${targetAppSelect.value}]`;
            
            setupForm.style.display = 'none';
            timerScreen.style.display = 'block';
            alertBox.style.display = 'none';

            updateTimerDisplay();
            
            // 1초마다 타이머 감소
            timerInterval = setInterval(runTimer, 1000);
        });

        // [STEP 2 & 3] 타이머 구동 및 알림 로직
        function runTimer() {
            remainingSeconds--;

            updateTimerDisplay();

            // STEP 3: 미리 알림 (사전 알림 기능)
            // 테스트 편의성을 위해 10분/5분 전 알림을 포함하되, 시간이 짧을 경우(예: 10초, 5초 전)에도 감지하도록 설정
            if (remainingSeconds === 600) { // 10분 전
                showAlert("⚠️ 제한 시간 10분 전입니다! 정리 준비를 하세요.");
            } else if (remainingSeconds === 300) { // 5분 전
                showAlert("⚠️ 제한 시간 5분 전입니다! 곧 핸드폰이 잠깁니다.");
            } else if (totalSeconds < 300 && remainingSeconds === 10) { // 5분 미만 설정 시 10초 전 테스트용
                showAlert("⚠️ 10초 후 핸드폰 사용이 제한됩니다!");
            }

            // [STEP 4] 시간 종료 시 차단
            if (remainingSeconds <= 0) {
                clearInterval(timerInterval);
                triggerLockScreen();
            }
        }

        // 화면 시간 업데이트
        function updateTimerDisplay() {
            const m = Math.floor(remainingSeconds / 60);
            const s = remainingSeconds % 60;
            timeText.innerText = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
        }

        // 사전 알림 메시지 출력
        function showAlert(msg) {
            alertBox.innerText = msg;
            alertBox.style.display = 'block';
        }

        // [STEP 4] 화면 차단 실행
        function triggerLockScreen() {
            lockedAppName.innerText = targetAppSelect.value;
            lockScreen.style.display = 'flex';
        }

        // 중단 버튼 클릭
        stopBtn.addEventListener('click', () => {
            if (confirm('정말 공부를 중단하시겠습니까?')) {
                clearInterval(timerInterval);
                resetUI();
            }
        });

        // [STEP 5] 리셋 및 처음으로
        resetBtn.addEventListener('click', () => {
            lockScreen.style.display = 'none';
            resetUI();
        });

        function resetUI() {
            setupForm.style.display = 'block';
            timerScreen.style.display = 'none';
            alertBox.style.display = 'none';
        }
    </script>
</body>
</html>
